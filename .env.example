# Заполняются автоматически при подключении Vercel Marketplace -> Upstash Redis
# либо возьми значения из консоли Upstash (REST API) и впиши вручную.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Если интеграция называется "Upstash Redis" (не Vercel KV), переменные будут такими —
# можно оставить оба варианта, код проверяет оба:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# sms.ru — проверка номера по звонку. api_id в личном кабинете sms.ru (главная страница).
# Никогда не коммитить реальное значение.
SMSRU_API_ID=
# Только для локальной разработки: 1 = не звонить в sms.ru, подтверждать "звонок" через 6 секунд
CALLCHECK_MOCK=
